{
  "name": "avyron-bestiary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --stream run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:create": "pnpm --filter @bestiary/db run create",
    "db:generate": "pnpm --filter @bestiary/db run generate",
    "db:migrate": "pnpm --filter @bestiary/db run migrate",
    "db:seed": "pnpm --filter @bestiary/db run seed",
    "db:dump": "pnpm --filter @bestiary/db run dump",
    "db:restore": "pnpm --filter @bestiary/db run restore",
    "db:studio": "pnpm --filter @bestiary/db run studio",
    "models:optimize": "node scripts/optimize-models.mjs",
    "models:placeholders": "node scripts/convert-placeholders.mjs",
    "models:biomes": "node scripts/convert-biomes.mjs",
    "models:characters": "node scripts/convert-characters.mjs",
    "badges:optimize": "node scripts/optimize-badges.mjs",
    "db:reset": "pnpm db:create && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "openapi:generate": "pnpm --filter @bestiary/web run openapi:generate",
    "game:export": "node scripts/export-game-data.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "ktx2-encoder": "^0.6.0",
    "sharp": "^0.35.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
