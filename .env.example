# Shared config — copy to .env at the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5102/bestiary
API_KEY=change-me-before-running
# Mesma chave acima, exposta ao bundle do Vite (prefixo VITE_ obrigatório).
# Usada só pelo botão dev "sincronizar modelos" em apps/web — nunca preencher
# isto num .env.production, o bundle de build vai público.
VITE_API_KEY=change-me-before-running
API_PORT=5101
NODE_ENV=development
# Empty = permissive CORS (origin: true). Só faz diferença se o bestiário
# voltar a ser servido publicamente — hoje ele roda local.
CORS_ORIGIN=
FONTES_DIR=./fontes

# Não há mais variável de produção aqui. O bestiário roda local, e o conteúdo
# durável é `packages/db/snapshot/`, versionado no repositório:
#   pnpm db:dump      grava o snapshot depois de escrever pela API
#   pnpm db:restore    hidrata uma máquina do zero, sem rede
# Ver docs/DATA_WORKFLOW.md.
