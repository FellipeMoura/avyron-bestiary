{"id":9,"code":"CRT-009","original_name":"Meganeura","base_species":"Meganeura","class_id":2,"element_id":3,"map_id":1,"biome_id":null,"role":"regular","silhouette_note":"Silhueta em cruz: dois pares de asas horizontais (~70 cm de envergadura) dominam a vista superior; corpo tipo agulha alongado (torax compacto, abdomen segmentado); cabeca pequena com olhos compostos desproporcionalmente grandes; sem cauda pontuda.","status":"Rascunho","created_at":"2026-08-04T15:01:55.706Z","updated_at":"2026-08-10T19:28:42.995Z","model_url":"/models/CRT-009.glb"}
